<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20"
                Width="400"
                Height="300"
                Background="#1B1B1C">
            <!--  Add Controls for Previewer Here  -->
            <ComboBox SelectedIndex="0" Classes="toolbar-combobox">
                <ComboBoxItem Content="localhost" />
                <ComboBoxItem Content="producao"/>
                <ComboBoxItem Content="servidor-dev"/>
            </ComboBox>
        </Border>
    </Design.PreviewWith>

    <!--  Add Styles Here  -->
    <Styles.Resources>
        <SolidColorBrush x:Key="ToolbarBackground" Color="#1B1B1C" />
        <SolidColorBrush x:Key="ToolbarForeground" Color="#E8E8E8" />
        <SolidColorBrush x:Key="ToolbarSecondaryForeground" Color="#AEB6C3" />
        <SolidColorBrush x:Key="ToolbarBorder" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ToolbarControlBackground" Color="#202020" />
        <SolidColorBrush x:Key="ToolbarButtonHover" Color="#2D2D30" />
        <SolidColorBrush x:Key="ToolbarButtonPressed" Color="#3E3E42" />
        <SolidColorBrush x:Key="ToolbarAccent" Color="#168CFF" />
    </Styles.Resources>

    <Style Selector="Border.divider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="Border.toolbar-root">
        <Setter Property="Background" Value="{StaticResource ToolbarBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonHover}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonPressed}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="#686868" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="StackPanel.toolbar-actions">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="1" />
    </Style>

    <Style Selector="Button">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="SplitButton">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="SplitButton.toolbar-split:pointerover /template/ Button#PART_PrimaryButton">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonHover}" />
    </Style>

    <Style Selector="SplitButton.toolbar-split:pointerover /template/ Button#PART_SecondaryButton /template/ ContentPresenter">
        <Setter Property="Background" Value="#173B5C" />
    </Style>

    <Style Selector="SplitButton.toolbar-split /template/ Border#SeparatorBorder">
        <Setter Property="Width" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="SplitButton.toolbar-split /template/ Button#PART_PrimaryButton">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="SplitButton.toolbar-split /template/ Button#PART_SecondaryButton">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="SplitButton.toolbar-split /template/ Button#PART_SecondaryButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#173B5C" />
    </Style>

    <Style Selector="SplitButton.toolbar-split /template/ Button#PART_PrimaryButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonPressed}" />
    </Style>

    <Style Selector="SplitButton.toolbar-split:flyout-open /template/ Button#PART_PrimaryButton">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonPressed}" />
    </Style>

    <Style Selector="SplitButton.toolbar-split:flyout-open /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonPressed}" />
    </Style>

    <Style Selector=".toolbar-button-content Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>

    <Style Selector=".toolbar-button-content TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.toolbar-button-content">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.auto-commit-control">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.auto-commit-label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton.auto-commit-switch">
        <Setter Property="Height" Value="34" />
        <Setter Property="Width" Value="20" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="#51545A"/>
        <Setter Property="BorderBrush" Value="#677B72"/>
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="34"
                        Height="20"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                    <Border x:Name="SwitchThumb"
                            Width="14"
                            Height="14"
                            Margin="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#F7F9FC"
                            CornerRadius="7"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToggleButton.auto-commit-switch:checked">
        <Setter Property="Background" Value="{StaticResource ToolbarAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarAccent}" />
    </Style>

    <Style Selector="ToggleButton.auto-commit-switch:checked /template/ Border#SwitchThumb">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="ToggleButton.auto-commit-switch:pointerover">
        <Setter Property="Background" Value="#60646B" />
    </Style>

    <Style Selector="ToggleButton.auto-commit-switch:checked:pointerover">
        <Setter Property="Background" Value="#329bff"/>
        <Setter Property="BorderBrush" Value="#329bff" />
    </Style>

    <Style Selector="ComboBox.toolbar-combobox">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ComboBox.toolbar-combobox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="Background" Value="{StaticResource ToolbarButtonHover}" />
    </Style>

    <Style Selector="Border.search-border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.search-border:focus-within">
        <Setter Property="Background" Value="#3A3A3A"/>
    </Style>

    <Style Selector="TextBox.toolbar-textbox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="32, 0, 0, 0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox.toolbar-textbox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TextBox.toolbar-textbox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.search-border:pointerover">
        <Setter Property="Background" Value="{StaticResource ToolbarButtonHover}" />
    </Style>

    <!-- Dimensao dos icons -->
    <Style Selector="PathIcon.icons-phos">
        <Setter Property="Height" Value="14" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Foreground" Value="#AEB6C3" />
    </Style>

    <Style Selector="PathIcon.icon-search">
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="#7F8996" />
    </Style>
</Styles>
