<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->

    <Style
        Selector="chrome|WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style
        Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style
        Selector="chrome|WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button /template/ ContentPresenter">
        <Setter Property="Background" Value="#181818"/>
    </Style>

    <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2D2D30"/>
    </Style>

    <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#3E3E42"/>
    </Style>


</Styles>
