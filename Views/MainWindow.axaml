<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLstudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SQLstudio.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SQLstudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SQLstudio"
        Background="#1E1E1E"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="32">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="/Styles/WindowControlsStyles.axaml" />
    </Window.Styles>

    <Grid RowDefinitions="100, *" TextElement.FontFamily="Segoe UI">

        <Border Grid.Column="0" BorderThickness="0,0,0,1"
                BorderBrush="#3A3A3A">
            <Grid RowDefinitions="30,24, *">
                <Grid Grid.Row="0">
                    <controls:WindowControls/>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#3A3A3A"
                        BorderThickness="0,0,0,1">
                    <controls:AppMenu />
                </Border>

                <Grid Grid.Row="2">
                    <controls:AppToolbar />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="185, *">
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#3A3A3A"
                    Background="#181818">
                <Grid RowDefinitions="35,Auto,*">
                    <Grid ColumnDefinitions="*,Auto, Auto" ColumnSpacing="4"
                          Margin="13,5,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Connections"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Foreground="#AEB6C3"
                                Content="+"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Background="Transparent"
                                Padding="0"
                                FontSize="16"
                                BorderThickness="0"
                                Height="28"
                                Width="28"/>
                        <Button Grid.Column="2"
                                Foreground="#AEB6C3"
                                Content="..."
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Height="28"
                                Width="28"
                                BorderThickness="0"
                                FontSize="16"
                                Background="Transparent"
                                />
                    </Grid>

                    <TextBox Grid.Row="1" Height="24" Width="170"
                             MinHeight="0"
                             Margin="4" PlaceholderText="⌕  Filter connections"
                             FontSize="8"
                             PlaceholderForeground="White"
                             Padding="8,0"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Background="#202020"/>
                </Grid>
            </Border>

            <Border Grid.Column="1">
                <controls:NoDatabaseConnected HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>

</Window>
