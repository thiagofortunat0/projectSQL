<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLstudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:SQLstudio.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SQLstudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SQLstudio"
        Background="#1E1E1E"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="32">

    <Window.Styles>
        <Style
            Selector="chrome|WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style
            Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style
            Selector="chrome|WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button /template/ ContentPresenter">
            <Setter Property="Background" Value="#181818"/>
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3E3E42"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="100, *" TextElement.FontFamily="Segoe UI">

        <Border Grid.Column="0" BorderThickness="0,0,0,1"
                BorderBrush="#3A3A3A">
            <Grid RowDefinitions="30,24, *">
                <Border Grid.Row="0"
                        BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                        WindowDecorationProperties.ElementRole="TitleBar"
                        Background="#181818">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                          Margin="10,0,0,0">
                        <TextBlock Text="ginseng strip 2002" Foreground="White"
                                   VerticalAlignment="Center" FontSize="14"
                                   FontWeight="Light"
                                   Grid.Column="1"/>
                        <Image Grid.Column="0"
                               Source="/Assets/Icons/barca.png"
                               VerticalAlignment="Center"
                               Width="21"
                               Height="21"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="#3A3A3A"
                        BorderThickness="0,0,0,1">
                    <controls:AppMenu />
                </Border>

                <Grid Grid.Row="2">
                    <controls:AppToolbar />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="185, *">
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#3A3A3A"
                    Background="#181818">
                <Grid RowDefinitions="35,Auto,*">
                    <Grid ColumnDefinitions="*,Auto, Auto" ColumnSpacing="4"
                          Margin="13,5,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Connections"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Foreground="#AEB6C3"
                                Content="+"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Background="Transparent"
                                Padding="0"
                                FontSize="16"
                                BorderThickness="0"
                                Height="28"
                                Width="28"/>
                        <Button Grid.Column="2"
                                Foreground="#AEB6C3"
                                Content="..."
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Height="28"
                                Width="28"
                                BorderThickness="0"
                                FontSize="16"
                                Background="Transparent"
                                />
                    </Grid>

                    <TextBox Grid.Row="1" Height="24" Width="170"
                             MinHeight="0"
                             Margin="4" Watermark="⌕  Filter connections"
                             FontSize="8"
                             WatermarkForeground="White"
                             Padding="8,0"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Background="#202020"/>
                </Grid>
            </Border>

            <Border Grid.Column="1">
                <controls:NoDatabaseConnected HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>

</Window>
