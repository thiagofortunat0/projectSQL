<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLstudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SQLstudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SQLstudio"
        Background="#1E1E1E">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

<Grid RowDefinitions="100, *">

        <Border Grid.Column="0" BorderThickness="0,0,0,1"
                BorderBrush="#3A3A3A">
        </Border>

        <Grid Grid.Row="1" 
              ColumnDefinitions="185, *">
            <Border Grid.Column="0" 
                    BorderThickness="0,0,1,0" 
                    BorderBrush="#3A3A3A"
                    Background="#181818">
                <Grid RowDefinitions="35,Auto,*">
                   <Grid ColumnDefinitions="*,Auto, Auto" ColumnSpacing="4"
                         Margin="13,5,0,0">
                       <TextBlock Grid.Column="0" 
                                  Text="Conexoes"
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>

                       <Button Grid.Column="1"
                               Foreground="#AEB6C3"
                               Content="+"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               Background="Transparent"
                               Padding="0"
                               FontSize="16"
                               BorderThickness="0"
                               Height="28"
                               Width="28"/>
                       <Button Grid.Column="2" 
                               Foreground="#AEB6C3"
                               Content="..."
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               Padding="0"
                               Height="28"
                               Width="28"
                               BorderThickness="0"
                               FontSize="16"
                               Background="Transparent"
                               />
                   </Grid>

                    <TextBox Grid.Row="1" Height="24" Width="170"
                             MinHeight="0"
                             Margin="4" Watermark="⌕  Filtrar conexões"
                             FontSize="8" 
                             WatermarkForeground="White"
                             Padding="8,0"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Background="#202020"/>
                </Grid>
            </Border>

            <Border Grid.Column="1">
                
            </Border>
        </Grid>
    </Grid>

</Window>
